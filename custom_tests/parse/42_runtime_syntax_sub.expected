int log_value(const char* format, ...);

int main() {
    int* value = new(value, 42);
    while (value != nullptr; outer) {
        delete(value);
        value = nullptr;
        continue outer;
    }
    FILE* file = fopen("input.txt", "r");
    return fclose(file);
}

