        int inner_scoped_var = 100;
        calculated = calculated + inner_scoped_var;
    }

        ;
    ;
}

struct Config {
    int id;
    int values[3];
};

int main() {
    Config cfg = {1, {10, 20, 30}};
    example_function(cfg.id, cfg.values[0]);
    return 0;
}

