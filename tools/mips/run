#!/usr/bin/env bash
# Assemble and link a MIPS64el assembly file, then run it through the binary launcher.
set -euo pipefail

usage() {
    printf 'usage: %s [-c harness.c] file.s [args...]\n' "$0" >&2
    exit 2
}

harness=
if [[ ${1:-} == -c ]]; then
    [[ $# -ge 3 && -f "$2" ]] || usage
    harness=$2
    shift 2
fi
[[ $# -ge 1 && -f "$1" ]] || usage
src=$1
shift

work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT
cp -- "$src" "$work/prog.s"
inputs=(prog.s)
if [[ -n $harness ]]; then
    cp -- "$harness" "$work/harness.c"
    inputs+=(harness.c)
fi

docker run --rm --pull=never --user "$(id -u):$(id -g)" -v "$work:/work" baka-mips64el \
    mips64el-linux-gnuabi64-gcc -march=mips64r2 -mabi=64 -static -no-pie "${inputs[@]}" -o prog.out || exit 125

# Wait asynchronously so Bash can forward interrupts and still remove the work directory.
"$(dirname -- "$0")/run-binary" "$work/prog.out" "$@" <&0 &
runtime_pid=$!
forward_signal() {
    interrupted=1
    kill -s "$1" "$runtime_pid" 2>/dev/null || :
}
trap 'forward_signal INT' INT
trap 'forward_signal TERM' TERM
while true; do
    interrupted=
    status=0
    wait "$runtime_pid" || status=$?
    [[ $interrupted ]] || exit "$status"
done
