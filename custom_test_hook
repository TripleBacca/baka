#!/usr/bin/env python3
import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent

custom_tests = ROOT / "custom_tests"
if not custom_tests.exists():
    custom_tests = ROOT / "test"

COMPILER = ROOT / "build" / "baka"
COMPILER_FLAGS = ["--verbose", "--build_type", "debug"]

SUITES = {
    "lex": (custom_tests / "lex", ["--lex"]),
    "parse": (custom_tests / "parse", ["--parse"]),
    "codegen": (custom_tests / "codegen", ["--codegen"]),
    "semantic": (custom_tests / "semantic", ["--semantic"]),
    "ir": (custom_tests / "ir", ["--ir"]),
    "ir_opt": (custom_tests / "ir_opt", ["--ir", "--optimize"]),
}



def get_compile_output(source, stage_args):
    arg = str(source.relative_to(ROOT))
    return subprocess.run(
        [str(COMPILER)] + COMPILER_FLAGS + stage_args + [arg],
        capture_output=True,
        text=True,
        errors="replace",
        timeout=10,
    )


# Checks the compiler status, diagnostics, and stdout for each lexer or parser
# fixture. Bless mode refreshes snapshots for fixtures with the expected status.
def check_snapshots(tests, stage_args, bless):
    failures = 0
    for source in tests:
        label = source.relative_to(ROOT)
        expected_file = source.with_suffix(".expected")
        try:
            result = get_compile_output(source, stage_args)
        except (OSError, subprocess.TimeoutExpired) as error:
            print(f"FAIL {label}: {error}")
            failures += 1
            continue

        expected_status = 1 if "invalid" in source.stem.split("_") else 0
        if result.returncode != expected_status or result.stderr:
            print(f"FAIL {label}: exit status {result.returncode}, expected {expected_status}")
            if result.stderr:
                print(result.stderr)
            failures += 1
            continue

        if bless:
            expected_file.write_text(result.stdout, encoding="utf-8")
            print(f"blessed {expected_file.relative_to(ROOT)}")
            continue
        if not expected_file.exists():
            print(f"FAIL {label}: no expected output {expected_file.relative_to(ROOT)}")
            failures += 1
            continue
        expected = expected_file.read_text(encoding="utf-8")
        if result.stdout != expected:
            print(f"FAIL {label}")
            diff_lines(result.stdout, expected)
            failures += 1
        else:
            print(f"PASS {label}")

    return bool(failures)


def diff_lines(actual: str, expected: str) -> None:
    import difflib

    for line in difflib.unified_diff(
        expected.splitlines(),
        actual.splitlines(),
        fromfile="expected",
        tofile="actual",
        lineterm="",
    ):
        print(f"  {line}")


# Dispatches the requested suites and returns a nonzero status if any checks fail.
def main():
    os.chdir(ROOT)

    requested = [arg for arg in sys.argv[1:] if arg in SUITES]
    suites = sorted(SUITES) if not requested else requested

    about_to_bless = "bless" in sys.argv[1:]

    failures = 0
    for name in suites:
        if name == "ir":
            failures += subprocess.run([sys.executable, "-B", str(custom_tests / "ir" / "run.py"),
                                        "--compiler", str(COMPILER)]).returncode
            continue
        if name in ("ir_opt", "codegen"):
            # Optimized TAC shape, and native MIPS64 execution under QEMU (Docker).
            failures += subprocess.run([sys.executable, "-B", str(custom_tests / name / "run.py"),
                                        "--compiler", str(COMPILER)]).returncode
            continue
        if name == "semantic":
            # Check acceptance and diagnostic messages for the semantic fixtures.
            failures += subprocess.run([sys.executable, str(custom_tests / "semantic" / "run.py")]).returncode
            continue
        test_dir, stage_args = SUITES[name]

        tests = sorted(test_dir.glob("*.cpp"))

        if not tests:
            if requested:
                print(f"no tests found in {test_dir.relative_to(ROOT)}")
            continue

        failures += check_snapshots(tests, stage_args, about_to_bless)

    return (1 if failures else 0)


if __name__ == "__main__":
    sys.exit(main())
