#!/usr/bin/env python3
import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent

custom_tests = ROOT / "custom_tests"
if not custom_tests.exists():
    custom_tests = ROOT / "test"

COMPILER = ROOT / "build" / "baka"
COMPILER_FLAGS = ["--verbose", "--build_type", "debug"]

SUITES = {
    "lex": (custom_tests / "lex", ["--lex"]),
    "parse": (custom_tests / "parse", ["--parse"]),
    "codegen": (custom_tests / "codegen", ["--codegen"]),
}



def get_compile_output(source, stage_args):
    arg = str(source.relative_to(ROOT))
    return subprocess.run(
        [str(COMPILER)] + COMPILER_FLAGS + stage_args + [arg],
        capture_output=True,
        text=True,
        errors="replace",
    )


def bless(tests, stage_args) -> None:
    for i in tests:
        result = get_compile_output(i, stage_args)
        expected_file = i.with_suffix(".expected")

        expected_file.write_text(result.stdout, encoding="utf-8")

        print(f"blessed {expected_file.relative_to(ROOT)} : exit-code({result.returncode})")


def verify(tests, stage_args):
    failures = 0
    for i in tests:

        expected_file = i.with_suffix(".expected")
        if not expected_file.exists():
            print(f"FAIL {i.relative_to(ROOT)}: no expected output {expected_file.relative_to(ROOT)}")
            failures += 1
            continue

        result = get_compile_output(i, stage_args)
        expected = expected_file.read_text(encoding="utf-8")

        if result.stdout == expected:
            print(f"PASS {i.relative_to(ROOT)}")
        else:
            print(f"FAIL {i.relative_to(ROOT)}")

            diff_lines(result.stdout, expected)
            failures += 1

    return (1 if failures else 0)


def diff_lines(actual: str, expected: str) -> None:
    import difflib

    for line in difflib.unified_diff(
        expected.splitlines(),
        actual.splitlines(),
        fromfile="expected",
        tofile="actual",
        lineterm="",
    ):
        print(f"  {line}")


def main():
    os.chdir(ROOT)

    requested = [arg for arg in sys.argv[1:] if arg in SUITES]
    suites = sorted(SUITES) if not requested else requested

    about_to_bless = "bless" in sys.argv[1:]

    failures = 0
    for name in suites:
        test_dir, stage_args = SUITES[name]

        tests = sorted(test_dir.glob("*.cpp"))

        if not tests:
            if requested:
                print(f"no tests found in {test_dir.relative_to(ROOT)}")
            continue

        if about_to_bless:
            bless(tests, stage_args)
        else:
            failures += verify(tests, stage_args)

    return (1 if failures else 0)


if __name__ == "__main__":
    sys.exit(main())