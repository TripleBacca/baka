#!/usr/bin/env python3
import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent

TESTS_DIR = ROOT / "custom_tests" / "tests"

COMPILER = ROOT / "build" / "baka"
COMPILER_FLAGS = ["--verbose", "--build_type", "debug"]


def get_compile_output(source):
    arg = str(source.relative_to(ROOT))
    return subprocess.run(
        [str(COMPILER)] + COMPILER_FLAGS + [arg],
        capture_output=True,
        text=True,
        errors="replace",
    )


def bless(tests) -> None:
    for i in tests:
        result = get_compile_output(i)
        expected_file = i.with_suffix(".expected")

        expected_file.write_text(result.stdout, encoding="utf-8")

        print(f"blessed {expected_file.relative_to(ROOT)} : exit-code({result.returncode})")


def verify(tests):
    failures = 0
    for i in tests:

        expected_file = i.with_suffix(".expected")
        if not expected_file.exists():
            print(f"FAIL {i.relative_to(ROOT)}: no expected output {expected_file.relative_to(ROOT)}")
            failures += 1
            continue

        result = get_compile_output(i)
        expected = expected_file.read_text(encoding="utf-8")

        if result.stdout == expected:
            print(f"PASS {i.relative_to(ROOT)}")
        else:
            print(f"FAIL {i.relative_to(ROOT)}")

            diff_lines(result.stdout, expected)
            failures += 1

    return (1 if failures else 0)


def diff_lines(actual: str, expected: str) -> None:
    import difflib

    for line in difflib.unified_diff(
        expected.splitlines(),
        actual.splitlines(),
        fromfile="expected",
        tofile="actual",
        lineterm="",
    ):
        print(f"  {line}")


def main():
    os.chdir(ROOT)

    tests = sorted(TESTS_DIR.glob("*.cpp"))

    if not tests:
        print(f"no tests found in {TESTS_DIR}")
        return 1

    if "bless" in sys.argv[1:]:
        bless(tests)
        return 0

    return verify(tests)


if __name__ == "__main__":
    sys.exit(main())
